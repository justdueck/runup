{
  "name": "runup",
  "version": "0.1.0",
  "description": "Personal flight-planning MCP server: free calendar windows, aircraft availability, weather scored against personal minimums, and candidate routes.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "runup": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "setup": "npm run build && node scripts/setup-claude-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "node-ical": "^0.27.1",
    "playwright": "1.56.1",
    "suncalc": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
